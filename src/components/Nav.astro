---
const links = [
  { label: "Inicio", href: "/" },
  { label: "Calendario", href: "/calendario" },
];
const linksDerecha = [
  { label: "Fotos", href: "/fotos" },
  { label: "Stats", href: "#" },
];
---

<header class="nav">
  <nav class="nav-links izquierda">
    {links.map((l) => (
      <a href={l.href}>{l.label}</a>
    ))}
  </nav>

  <a href="#" class="logo">
    <span class="logo-icono">💪</span>
    <span class="logo-texto">
      GYMPO
      <small>calendario del año</small>
    </span>
  </a>

  <nav class="nav-links derecha">
    {linksDerecha.map((l) => (
      <a href={l.href}>{l.label}</a>
    ))}
  </nav>
</header>

<style>
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 2rem;
    background: #0d0d0d;
    border-bottom: 1px solid #262626;
    position: sticky;
    top: 0;
    z-index: 40;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    flex: 1;
  }

  .nav-links.derecha {
    justify-content: flex-end;
  }

  .nav-links a {
    color: #ccc;
    text-decoration: none;
    font-family: system-ui, sans-serif;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color 0.15s ease;
  }

  .nav-links a:hover {
    color: #22c55e;
  }

  .logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    padding: 0 2rem;
  }

  .logo-icono {
    font-size: 1.6rem;
    line-height: 1;
  }

  .logo-texto {
    display: flex;
    flex-direction: column;
    align-items: center;
    color: #22c55e;
    font-family: system-ui, sans-serif;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.1em;
    margin-top: 0.25rem;
  }

  .logo-texto small {
    color: #888;
    font-weight: 400;
    font-size: 0.6rem;
    letter-spacing: 0.05em;
    text-transform: none;
  }

  @media (max-width: 700px) {
    .nav {
      flex-direction: column;
      gap: 0.75rem;
      padding: 1rem;
    }
    .nav-links {
      gap: 1rem;
      justify-content: center;
    }
    .logo {
      padding: 0;
    }
  }
</style>